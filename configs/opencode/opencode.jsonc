{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "servers": {
      "mcp-nixos": {
        "type": "local",
        "command": [
          "mcp-nixos"
        ]
      },
      "rea": {
        "type": "local",
        "command": [
          "rea",
          "mcp"
        ]
      }
    }
  }
}
